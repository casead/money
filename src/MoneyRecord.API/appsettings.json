{
  "ConnectionStrings": {
    "MoneyRecord": "mongodb://localhost:27017"
  },
  "MongoDb": {
    "DatabaseName": "moneyrecord"
  },
  "Jwt": {
    "Issuer": "MoneyRecord",
    "Audience": "MoneyRecordApp",
    "SigningKey": "dev-only-signing-key-change-in-production-0123456789abcdef",
    "AccessTokenMinutes": 525600,
    "RefreshTokenDays": 365
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
